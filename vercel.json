{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.traceremove.com" }],
      "destination": "https://traceremove.com/:path*",
      "permanent": true
    },
    {
      "source": "/process.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/blog/en/:slug*.php",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/fr/:slug*.php",
      "destination": "/fr/blog",
      "permanent": true
    },
    {
      "source": "/blog/es/:slug*.php",
      "destination": "/es/blog",
      "permanent": true
    },
    {
      "source": "/reputation-kit/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio-collections/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/accessibility-statement",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/accessibility-statement",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/consultation",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/resources/guides",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/industries/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets|api|favicon|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
