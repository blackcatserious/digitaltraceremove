{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.traceremove.com" }],
      "destination": "https://traceremove.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/en/:slug*.php",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/fr/:slug*.php",
      "destination": "/fr/blog",
      "permanent": true
    },
    {
      "source": "/blog/es/:slug*.php",
      "destination": "/es/blog",
      "permanent": true
    },
    {
      "source": "/blog/:lang/:slug*.php",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug*.php",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/process.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/services-pricing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/free-audit",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/reputation-score",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/breach-check",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/instagram",
      "destination": "/",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.php",
      "status": 410
    }
  ]
}
